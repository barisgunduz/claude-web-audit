{
  "name": "claude-web-audit",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source website audit for Claude Code. Crawls a site, scores SEO, speed, SSL, links, accessibility and AI visibility, then writes a report and an ordered fix plan Claude can follow.",
  "license": "MIT",
  "author": "Barış Gündüz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barisgunduz/claude-web-audit.git"
  },
  "bugs": {
    "url": "https://github.com/barisgunduz/claude-web-audit/issues"
  },
  "homepage": "https://github.com/barisgunduz/claude-web-audit#readme",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "cwa": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
